<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ellie Kilgallen | Profile</title>

    <style>
        body {
            margin: 0;
            padding: 40px;
            background-color: #f5f5f5;
            font-family: Arial, sans-serif;
        }

        .profile {
            max-width: 900px;
            margin: 0 auto;
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            display: flex;
            align-items: center;
            gap: 40px;
        }

        .profile-image {
            width: 280px;
            height: 360px;
            object-fit: cover;
            border-radius: 10px;
        }

        .profile-info {
            flex: 1;
        }

        .profile-info h1 {
            margin: 0 0 10px;
            font-size: 32px;
            color: #222;
        }

        .profile-info h2 {
            margin: 0 0 20px;
            font-size: 18px;
            font-weight: normal;
            color: #666;
        }

        .profile-info p {
            font-size: 16px;
            line-height: 1.6;
            color: #444;
        }

        @media (max-width: 700px) {
            .profile {
                flex-direction: column;
                text-align: center;
            }

            .profile-image {
                width: 220px;
                height: 280px;
            }
        }
    </style>
</head>

<body>

    <div class="profile">

        <img
            src="Screenshot 2025-09-18 at 5.53.06 PM-1024.jpg"
            alt="Professional profile photo of Ellie Kilgallen"
            class="profile-image"
        >

        <div class="profile-info">
            <h1>Ellie Kilgallen</h1>

            <h2>Marketing Student</h2>

            <p>
                Highly motivated marketing student with a
                <strong>3.857 GPA</strong> and experience in
                <strong>project management, event promotion, and community engagement.</strong>
            </p>
        </div>

    </div>

</body>
</html>
